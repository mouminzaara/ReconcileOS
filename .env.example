# Django Settings
SECRET_KEY=django-insecure-reconcileos-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite for local development)
# Set to 'postgres' to use PostgreSQL
DB_ENGINE=sqlite
DB_NAME=reconcileos_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
