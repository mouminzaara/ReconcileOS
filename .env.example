# ==============================================================================
# ReconcileOS Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit .env or genuine secret credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# In development: DEBUG=True allows the insecure dev secret fallback and localhost bindings.
# In production:  DEBUG=False is mandatory. SECRET_KEY and ALLOWED_HOSTS MUST be set explicitly.
DEBUG=True

# Must be a 50+ character unpredictable random string in production.
# In production, the application will refuse to start if this key starts with 'django-insecure-'.
SECRET_KEY=django-insecure-reconcileos-dev-key-change-in-production

# Comma-separated list of host/domain names that this Django site can serve.
# In production, specify your domain(s), e.g. api.reconcileos.enterprise.internal,10.0.1.20
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------------------------
# 2. HTTPS & COOKIE SECURITY (PRODUCTION ONLY)
# ------------------------------------------------------------------------------
# Set to True when serving over TLS/HTTPS (enables SSL redirect, secure cookies, HSTS).
# Leave False for local HTTP development.
ENABLE_HTTPS=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: SQLite (db.sqlite3 in project root) for local development & unit testing.
# For production PostgreSQL, you may either supply a 12-factor DATABASE_URL:
# DATABASE_URL=postgres://reconcileos_user:YOUR_STRONG_PASSWORD@localhost:5432/reconcileos_db
#
# Or configure the discrete parameters below:
DB_ENGINE=sqlite
DB_NAME=reconcileos_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 4. CORS & CSRF CONFIGURATION
# ------------------------------------------------------------------------------
# In production, wildcard CORS is automatically disabled.
# List all frontend client origins allowed to access the API:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. JWT AUTHENTICATION LIFETIMES
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional dedicated JWT signing key (defaults to SECRET_KEY if unset)
# JWT_SIGNING_KEY=your-dedicated-jwt-signing-key

# ------------------------------------------------------------------------------
# 6. EXTERNAL CONNECTORS CONFIGURATION (OPTIONAL / PHASE 4+)
# ------------------------------------------------------------------------------
# GitHub REST connector: If unset, GitHub connector operates in local DB fallback mode.
# GITHUB_ACCESS_TOKEN=ghp_sample_token_replace_with_genuine_personal_access_token
# GITHUB_ORG_NAME=your-organization

# Downstream connectors (VPN, Cloud IAM, Slack) default to safe local ORM state.
